{
  "name": "preact-web-component",
  "version": "0.0.2",
  "type": "module",
  "keywords": [
    "preact",
    "custom element",
    "web component"
  ],
  "author": "WuifDesign",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "unpkg": "./dist/index.umd.js",
  "jsdelivr": "./dist/index.umd.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wuifdesign/preact-web-component.git"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "/dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "sbx": "sbx run --name claude-preact-web-components",
    "dev": "vite",
    "build": "tsc -b && tsdown && size-limit",
    "test": "concurrently --c yellow,cyan,green ---names test,lint,type \"npm run test:vitest\" \"npm run test:lint\" \"npm run test:typecheck\"",
    "test:vitest": "vitest --watch false",
    "test:lint": "eslint --report-unused-disable-directives --max-warnings 0",
    "test:lint-fix": "eslint --report-unused-disable-directives --max-warnings 0 --fix",
    "test:typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "preact": "^10.0.0 || ^11.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@eslint/js": "^9.39.5",
    "@nabla/vite-plugin-eslint": "^3.0.1",
    "@preact/preset-vite": "^2.10.6",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@typescript-eslint/parser": "^8.72.1",
    "concurrently": "^10.0.6",
    "element-internals-polyfill": "^3.0.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "preact": "^11.1.0",
    "publint": "^0.3.25",
    "size-limit": "^14.3.0",
    "tsdown": "^0.23.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "unrun": "^0.3.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "volta": {
    "node": "24.22.2"
  }
}
