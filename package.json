{
  "name": "preact-web-component",
  "version": "0.0.2",
  "type": "module",
  "keywords": [
    "preact",
    "custom element",
    "web component"
  ],
  "author": "WuifDesign",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "unpkg": "./dist/index.umd.js",
  "jsdelivr": "./dist/index.umd.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wuifdesign/preact-web-component.git"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "/dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "sbx": "sbx run --name claude-preact-web-components",
    "dev": "vite",
    "build": "tsc -b && tsdown && npm run size",
    "size": "node scripts/check-size.js",
    "test": "concurrently --c yellow,cyan,magenta,green ---names test,lint,format,type \"npm run test:vitest\" \"npm run test:lint\" \"npm run test:format\" \"npm run test:typecheck\"",
    "test:vitest": "vitest --watch false",
    "test:lint": "oxlint --report-unused-disable-directives --max-warnings 0",
    "test:lint-fix": "oxlint --report-unused-disable-directives --max-warnings 0 --fix && oxfmt \"**/*.{js,jsx,ts,tsx,mjs,cjs}\"",
    "test:format": "oxfmt --check \"**/*.{js,jsx,ts,tsx,mjs,cjs}\"",
    "test:typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "preact": "^10.0.0 || ^11.0.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "concurrently": "^10.0.6",
    "element-internals-polyfill": "^3.0.2",
    "jsdom": "^30.1.3",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "preact": "^11.1.0",
    "tsdown": "^0.23.4",
    "typescript": "^6.0.3",
    "unrun": "^0.3.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "volta": {
    "node": "24.22.2"
  }
}
