{
  "name": "preact-web-component",
  "version": "0.0.2",
  "description": "Generate and register custom elements (Web Components) from Preact components, with first-class TypeScript support.",
  "type": "module",
  "keywords": [
    "preact",
    "custom element",
    "custom-elements",
    "web component",
    "web-components",
    "typescript"
  ],
  "author": "WuifDesign",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "unpkg": "./dist/index.umd.js",
  "jsdelivr": "./dist/index.umd.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wuifdesign/preact-web-component.git"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "/dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "sbx": "sbx run --name claude-preact-web-components",
    "dev": "vite demo",
    "build": "tsc && tsdown && npm run size",
    "size": "node scripts/check-size.js",
    "prepack": "npm run build",
    "test": "npm run test:vitest && npm run test:lint && npm run test:format && npm run test:typecheck",
    "test:vitest": "vitest --watch false",
    "test:lint": "oxlint --report-unused-disable-directives --max-warnings 0",
    "test:lint-fix": "oxlint --report-unused-disable-directives --max-warnings 0 --fix && oxfmt \"**/*.{js,jsx,ts,tsx,mjs,cjs}\"",
    "test:format": "oxfmt --check \"**/*.{js,jsx,ts,tsx,mjs,cjs}\"",
    "test:typecheck": "tsc"
  },
  "peerDependencies": {
    "preact": "^10.0.0 || ^11.0.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "element-internals-polyfill": "^3.0.2",
    "jsdom": "^30.1.3",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "preact": "^11.1.1",
    "tsdown": "^0.23.4",
    "typescript": "^6.0.3",
    "unrun": "^0.3.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "volta": {
    "node": "24.22.2"
  }
}
